# SnapTrade API keys. Get them at https://dashboard.snaptrade.com
# (Commercial account -> verify email -> enable 2FA -> API Keys -> create a test key).
# This file is gitignored: never commit real keys.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Where SnapTrade sends the user back after connecting a brokerage.
APP_URL=http://localhost:3000

# Optional: Finnhub API key, a backup price source when Yahoo Finance can't price a
# ticker. Free at https://finnhub.io (Get free API key -> Dashboard -> API key).
# Live prices work without it.
FINNHUB_API_KEY=
