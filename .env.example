# SnapTrade API keys. Get them at https://dashboard.snaptrade.com
# (Commercial account -> verify email -> enable 2FA -> API Keys -> create a test key).
# This file is gitignored: never commit real keys.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Where SnapTrade sends the user back after connecting a brokerage.
APP_URL=http://localhost:3000

# Optional: Finnhub API key. Used as the main news source for recommendations (more
# articles, with summaries) and as a backup price source when Yahoo Finance can't
# price a ticker. Free at https://finnhub.io (Get free API key -> Dashboard -> API key).
# Prices and news both work without it, from Yahoo Finance.
FINNHUB_API_KEY=

# Optional: Anthropic API key. Lets Claude write the "Your portfolio at a glance"
# summary and turn Folio's findings into specific recommendations on the
# Recommendations tab, using only the numbers Folio computed. Without it, both
# come from Folio's rules. About $0.001 per answer with the default model. Get a key at
# https://console.anthropic.com (API Keys). Usage is billed by Anthropic; answers
# are cached for 6 hours and only requested while the Recommendations tab is open.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default claude-haiku-5-5, the cheapest).
ANTHROPIC_MODEL=
